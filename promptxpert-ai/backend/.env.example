# Only these are needed. Everything else has a sensible default.
MISTRAL_API_KEY=your-free-mistral-key      # https://console.mistral.ai (free "Experiment" plan)
FRONTEND_URL=http://localhost:3000          # your Vercel URL in production (used for CORS)
SECRET_KEY=change-me                        # Render generates this for you
# Optional overrides:
# MISTRAL_MODEL=codestral-2508              # text-only prompt polishing
# MISTRAL_VISION_MODEL=mistral-small-latest # must be vision-capable
# DEBUG=1
